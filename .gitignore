# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境与配置（含敏感信息；仅保留 *.example 模板入库，真实配置一律忽略）
.env
config/env.toml
config/config.toml
config/connectors.toml
config/*.local.toml
!config/config.toml.example
!config/connectors.toml.example

# 项目运行数据
data/*
!data/examples/
data/examples/*
!data/examples/example.md
logs/
*.log

# 依赖安装包与升级包
update_package/
*.zip

# 前端构建产物
node_modules/
dist/

# 测试与调试
test/
dev/
backup/

# 项目专属 skill（含内部运维信息，不入库）
skill/

# 系统文件
.DS_Store
.idea/
.vscode/
